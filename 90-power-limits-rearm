#!/bin/sh
# Переармування EC після виходу зі сну (resume).
#
# Причина та сама, що й на буті (див. /etc/local.d/performance.start):
# без РЕАЛЬНОГО запису в /sys/firmware/acpi/platform_profile EC лишається
# із заниженим власним лімітом потужності, ігноруючи PL1/PL2 з throttled.
# elogind викликає скрипти цієї теки з аргументом $1 = pre|post, $2 = suspend|hibernate.

case "$1" in
    post)
        echo performance > /sys/firmware/acpi/platform_profile 2>/dev/null
        for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
            echo performance > "$f" 2>/dev/null
        done
        for f in /sys/devices/system/cpu/cpu*/cpuidle/state3/disable; do
            echo 1 > "$f" 2>/dev/null
        done
        # Turbo ratio limits: all groups 5.2 GHz (see /etc/local.d/performance.start)
        wrmsr -a 0x1AD 0x3434343434343434 2>/dev/null
        ;;
esac
